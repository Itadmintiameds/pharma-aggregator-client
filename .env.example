# API Gateway base URL, including the /api/v1 prefix and NO trailing slash.
# Read by src/lib/api.ts, src/lib/buyerApi.ts, src/utils/api.ts, IFSCService.ts
# and DashboardFilters.tsx. NEXT_PUBLIC_* values are inlined at build time, so
# rebuild the image/app after changing it.
#
# Local (api-gateway default port 8089):
NEXT_PUBLIC_API_URL=http://localhost:8089/api/v1
# Docker network / dev cluster:
# NEXT_PUBLIC_API_URL=http://api-gateway:8089/api/v1
# Test:
# NEXT_PUBLIC_API_URL=https://api-test-aggreator.tiameds.ai/api/v1
#
# The gateway's GATEWAY_CORS_ALLOWED_ORIGINS must include this app's origin
# (default http://localhost:3000).
